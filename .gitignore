# Claude Code 本机设定(个人/会话层级,不进版本库)
.claude/settings.local.json

# uv 管理的專案本地虛擬環境(由 uv sync 重建,不進版本庫)
.venv/

# Python 位元碼與測試快取
__pycache__/
*.py[cod]
.pytest_cache/

# mutmut 變異測試的專案副本(每次 `mutmut run` 重建)
mutants/

# deploy-cloud-run.sh 的本機部署設定,內含 GCP_PROJECT_ID —— 帳單/資源歸屬的識別碼,
# 不進版本庫。範本見 env.example。
.env
