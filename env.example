# 複製為 .env(檔名務必是 .env,不是 env.example —— 已加進 .gitignore,不會進
# 版本庫)並填入實際值。deploy-cloud-run.sh 執行時會自動讀取 .env —— GCP_PROJECT_ID
# 是帳單與資源歸屬的識別碼,不該出現在 repo 裡任何會被 commit 的檔案中。

GCP_PROJECT_ID=

# 以下皆為選填,不設定時 deploy-cloud-run.sh 會用腳本內的預設值:
# REGION=asia-east1
# SERVICE_NAME=leetchess
# MEMORY=1Gi
# CPU=1
# ALLOW_UNAUTHENTICATED=true

# 對應 service/config.py 的 LEETCHESS_POOL_SIZE(引擎池容量,即同時能處理的搜尋數)。
# 目前只是試跑規模,故先給 1;有實際流量後再依 design 的 2.3 任務量測結果調大。
# LEETCHESS_POOL_SIZE=1

# 單一服務最多同時開幾個 Cloud Run instance 的硬上限——不是給預期流量用的,是
# 萬一連結外流或被爬蟲打到時的成本煞車(budget alert 只會通知,不會真的擋錢)。
# MAX_INSTANCES=3
